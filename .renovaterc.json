{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>particify/dev/devops/renovate-dependency-bot//presets/default"
  ],
  "baseBranchPatterns": ["master", "3.13"],
  "packageRules": [
    {
      "matchPackageNames": ["com.graphql-java:graphql-java-extended-scalars"],
      "allowedVersions": "/^[0-9]+\\.[0-9]+(\\.[0-9]+)?$/"
    },
    {
      "description": "Word-list data only, no code: update by hand",
      "matchFileNames": ["gradle/password-dictionaries.versions.toml"],
      "enabled": false
    }
  ]
}
