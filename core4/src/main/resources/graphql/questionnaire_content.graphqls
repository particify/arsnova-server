extend type Query {
  questionnaireContentsByQuestionnaireId(
    questionnaireId: UUID!
  ): ContentConnection
  questionnairePublishedContentsByQuestionnaireId(
    questionnaireId: UUID!
  ): ContentConnection
  questionnaireContentById(id: UUID!): Content
}

extend type Mutation {
  banQuestionnaireShortAnswerContentKeyword(
    contentId: UUID!
    keyword: String!
  ): Content
  banQuestionnaireWordcloudContentKeyword(
    contentId: UUID!
    keyword: String!
  ): Content
  copyQuestionnaireContentToQuestionnaire(
    contentId: UUID!
    questionnaireId: UUID!
  ): Content
  createQuestionnaireBinaryContent(input: CreateBinaryContentInput!): Content
  createQuestionnaireChoiceContent(input: CreateChoiceContentInput!): Content
  createQuestionnaireFlashcardContent(
    input: CreateFlashcardContentInput!
  ): Content
  createQuestionnaireNumericContent(input: CreateNumericContentInput!): Content
  createQuestionnairePrioritizationContent(
    input: CreatePrioritizationContentInput!
  ): Content
  createQuestionnaireScaleContent(input: CreateScaleContentInput!): Content
  createQuestionnaireShortAnswerContent(
    input: CreateShortAnswerContentInput!
  ): Content
  createQuestionnaireSlideContent(input: CreateSlideContentInput!): Content
  createQuestionnaireSortContent(input: CreateSortContentInput!): Content
  createQuestionnaireTextContent(input: CreateTextContentInput!): Content
  createQuestionnaireWordcloudContent(
    input: CreateWordcloudContentInput!
  ): Content
  deleteQuestionnaireContent(id: ID!): ID
  duplicateQuestionnaireContent(id: ID!): Content
  moveQuestionnaireContentToQuestionnaire(
    contentId: UUID!
    questionnaireId: UUID!
  ): Content
  resetBannedQuestionnaireShortAnswerContentKeywords(contentId: UUID!): Content
  resetBannedQuestionnaireWordcloudContentKeywords(contentId: UUID!): Content
  toggleQuestionnaireTextContentAnswersPublished(
    contentId: UUID!
    published: Boolean!
  ): Content
  updateQuestionnaireBinaryContent(input: UpdateBinaryContentInput!): Content
  updateQuestionnaireChoiceContent(input: UpdateChoiceContentInput!): Content
  updateQuestionnaireFlashcardContent(
    input: UpdateFlashcardContentInput!
  ): Content
  updateQuestionnaireNumericContent(input: UpdateNumericContentInput!): Content
  updateQuestionnairePrioritizationContent(
    input: UpdatePrioritizationContentInput!
  ): Content
  updateQuestionnaireScaleContent(input: UpdateScaleContentInput!): Content
  updateQuestionnaireShortAnswerContent(
    input: UpdateShortAnswerContentInput!
  ): Content
  updateQuestionnaireSlideContent(input: UpdateSlideContentInput!): Content
  updateQuestionnaireSortContent(input: UpdateSortContentInput!): Content
  updateQuestionnaireTextContent(input: UpdateTextContentInput!): Content
  updateQuestionnaireWordcloudContent(
    input: UpdateWordcloudContentInput!
  ): Content
}

extend type Subscription {
  questionnaireContentUpdated(questionnaireId: UUID!): Content
}

type Content {
  id: ID!
  body: String!
  bodyRendered: String
  formatData: ContentFormatData!
  activeRound: Round
  duration: Int
  weight: Int
  abstentionsAllowed: Boolean
  hasCorrectAnswer: Boolean
  hasAnswers: Boolean!
  answerCount: Int
  correctAnswerCount: Int
  abstentionCount: Int
  position: Int
}

type ContentWithAnswer {
  id: ID!
  bodyRendered: String
  formatData: ContentFormatData!
  duration: Int
  abstentionsAllowed: Boolean
  answerResult: AnswerResultState
}

union ContentFormatData =
  | BinaryContentFormatData
  | ChoiceContentFormatData
  | FlashcardContentFormatData
  | NumericContentFormatData
  | PrioritizationContentFormatData
  | ScaleContentFormatData
  | ShortAnswerContentFormatData
  | SlideContentFormatData
  | SortContentFormatData
  | TextContentFormatData
  | WordcloudContentFormatData

type BinaryContentFormatData {
  format: ContentType!
  correctAnswer: Boolean
}

type ChoiceContentFormatData {
  format: ContentType!
  options: [AnswerOption!]!
  correctOptionIndexes: [Int!]
  multiple: Boolean
}

type AnswerOption {
  label: String!
  labelRendered: String
}

type FlashcardContentFormatData {
  format: ContentType!
  answer: String!
  answerRendered: String
}

type NumericContentFormatData {
  format: ContentType!
  minNumber: Float!
  maxNumber: Float!
  correctNumber: Float
  tolerance: Float!
}

type PrioritizationContentFormatData {
  format: ContentType!
  options: [AnswerOption!]!
  assignablePoints: Int!
}

type ScaleContentFormatData {
  format: ContentType!
  template: ScaleContentTemplate!
  neutralOption: Boolean!
}

enum ScaleContentTemplate {
  AGREEMENT
  INTENSITY
  FREQUENCY
  QUALITY
  PROBABILITY
  LEVEL
  IMPORTANCE
  DIFFICULTY
  PACE
  EMOJI
  PLUS_MINUS
  POINTS
}

type ShortAnswerContentFormatData {
  format: ContentType!
  correctTerms: [String!]!
}

type SlideContentFormatData {
  format: ContentType!
}

type SortContentFormatData {
  format: ContentType!
  options: [AnswerOption!]!
  correctOrder: [Int!]
}

type TextContentFormatData {
  format: ContentType!
  answersPublished: Boolean!
}

type WordcloudContentFormatData {
  format: ContentType!
  maxAnswers: Int!
}

enum ContentType {
  CHOICE
  SCALE
  TEXT
  BINARY
  NUMERIC
  WORDCLOUD
  SORT
  SHORT_ANSWER
  PRIORITIZATION
  FLASHCARD
  SLIDE
}

input CreateBinaryContentInput {
  questionnaireId: UUID!
  body: String!
  correctAnswer: Boolean
  duration: Int
  weight: Int
  abstentionsAllowed: Boolean
}

input UpdateBinaryContentInput {
  id: UUID!
  body: String!
  correctAnswer: Boolean
  duration: Int
  weight: Int
  abstentionsAllowed: Boolean
}

input CreateChoiceContentInput {
  questionnaireId: UUID!
  body: String!
  options: [String!]!
  correctOptionIndexes: [Int!]
  multiple: Boolean
  duration: Int
  weight: Int
  abstentionsAllowed: Boolean
}

input UpdateChoiceContentInput {
  id: UUID!
  body: String!
  options: [String!]!
  correctOptionIndexes: [Int!]
  multiple: Boolean
  duration: Int
  weight: Int
  abstentionsAllowed: Boolean
}

input CreateFlashcardContentInput {
  questionnaireId: UUID!
  body: String!
  answer: String!
}

input UpdateFlashcardContentInput {
  id: UUID!
  body: String!
  answer: String!
}

input CreateNumericContentInput {
  questionnaireId: UUID!
  body: String!
  minNumber: Float!
  maxNumber: Float!
  correctNumber: Float
  tolerance: Float
  duration: Int
  weight: Int
  abstentionsAllowed: Boolean
}

input UpdateNumericContentInput {
  id: UUID!
  body: String!
  minNumber: Float!
  maxNumber: Float!
  correctNumber: Float
  tolerance: Float
  duration: Int
  weight: Int
  abstentionsAllowed: Boolean
}

input CreatePrioritizationContentInput {
  questionnaireId: UUID!
  body: String!
  options: [String!]!
  duration: Int
  abstentionsAllowed: Boolean
}

input UpdatePrioritizationContentInput {
  id: UUID!
  body: String!
  options: [String!]!
  duration: Int
  abstentionsAllowed: Boolean
}

input CreateScaleContentInput {
  questionnaireId: UUID!
  body: String!
  template: ScaleContentTemplate!
  neutralOption: Boolean!
  duration: Int
  abstentionsAllowed: Boolean
}

input UpdateScaleContentInput {
  id: UUID!
  body: String!
  template: ScaleContentTemplate!
  neutralOption: Boolean!
  duration: Int
  abstentionsAllowed: Boolean
}

input CreateShortAnswerContentInput {
  questionnaireId: UUID!
  body: String!
  correctTerms: [String!]!
  duration: Int
  weight: Int
  abstentionsAllowed: Boolean
}

input UpdateShortAnswerContentInput {
  id: UUID!
  body: String!
  correctTerms: [String!]!
  duration: Int
  weight: Int
  abstentionsAllowed: Boolean
}

input CreateSlideContentInput {
  questionnaireId: UUID!
  body: String!
}

input UpdateSlideContentInput {
  id: UUID!
  body: String!
}

input CreateSortContentInput {
  questionnaireId: UUID!
  body: String!
  options: [String!]!
  duration: Int
  weight: Int
  abstentionsAllowed: Boolean
}

input UpdateSortContentInput {
  id: UUID!
  body: String!
  options: [String!]!
  duration: Int
  weight: Int
  abstentionsAllowed: Boolean
}

input UpdateWordcloudContentInput {
  id: UUID!
  body: String!
  duration: Int
  abstentionsAllowed: Boolean
  maxAnswers: Int!
}

input CreateTextContentInput {
  questionnaireId: UUID!
  body: String!
  duration: Int
  abstentionsAllowed: Boolean
}

input UpdateTextContentInput {
  id: UUID!
  body: String!
  duration: Int
  abstentionsAllowed: Boolean
}

input CreateWordcloudContentInput {
  questionnaireId: UUID!
  body: String!
  duration: Int
  abstentionsAllowed: Boolean
  maxAnswers: Int!
}
