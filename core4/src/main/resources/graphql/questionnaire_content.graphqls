extend type Query {
  questionnaireContentsByQuestionnaireId(
    questionnaireId: UUID!
  ): ContentConnection
  questionnairePublishedContentsByQuestionnaireId(
    questionnaireId: UUID!
  ): ContentConnection
  questionnaireContentById(id: UUID!): Content
}

extend type Mutation {
  banQuestionnaireWordcloudContentKeyword(
    contentId: UUID!
    keyword: String!
  ): Content
  copyQuestionnaireContentToQuestionnaire(
    contentId: UUID!
    questionnaireId: UUID!
  ): Content
  createQuestionnaireChoiceContent(input: CreateChoiceContentInput!): Content
  createQuestionnaireFlashcardContent(
    input: CreateFlashcardContentInput
  ): Content!
  createQuestionnaireSlideContent(input: CreateSlideContentInput): Content!
  createQuestionnaireWordcloudContent(
    input: CreateWordcloudContentInput!
  ): Content
  deleteQuestionnaireContent(id: ID!): ID
  duplicateQuestionnaireContent(id: ID!): Content
  moveQuestionnaireContentToQuestionnaire(
    contentId: UUID!
    questionnaireId: UUID!
  ): Content
  resetBannedQuestionnaireWordcloudContentKeywords(contentId: UUID!): Content
  updateQuestionnaireChoiceContent(input: UpdateChoiceContentInput!): Content
  updateQuestionnaireFlashcardContent(
    input: UpdateFlashcardContentInput
  ): Content!
  updateQuestionnaireSlideContent(input: UpdateSlideContentInput): Content!
  updateQuestionnaireWordcloudContent(
    input: UpdateWordcloudContentInput!
  ): Content
}

extend type Subscription {
  questionnaireContentUpdated(questionnaireId: UUID!): Content
}

type Content {
  id: ID!
  body: String!
  bodyRendered: String
  formatData: ContentFormatData!
  activeRound: Round
  duration: Int
  weight: Int
  abstentionsAllowed: Boolean
  hasCorrectAnswer: Boolean
  hasAnswers: Boolean!
  answerCount: Int
  correctAnswerCount: Int
  abstentionCount: Int
  position: Int
}

type ContentWithAnswer {
  id: ID!
  bodyRendered: String
  formatData: ContentFormatData!
  duration: Int
  abstentionsAllowed: Boolean
  answerResult: AnswerResultState
}

union ContentFormatData =
  | ChoiceContentFormatData
  | FlashcardContentFormatData
  | ScaleContentFormatData
  | SlideContentFormatData
  | TextContentFormatData
  | WordcloudContentFormatData

type ChoiceContentFormatData {
  format: ContentType!
  options: [AnswerOption!]!
  correctOptionIndexes: [Int!]
  multiple: Boolean
}

type AnswerOption {
  label: String!
  labelRendered: String
}

type FlashcardContentFormatData {
  format: ContentType!
  answer: String!
  answerRendered: String
}

type ScaleContentFormatData {
  format: ContentType!
}

type SlideContentFormatData {
  format: ContentType!
}

type TextContentFormatData {
  format: ContentType!
}

type WordcloudContentFormatData {
  format: ContentType!
  maxAnswers: Int!
}

enum ContentType {
  CHOICE
  SCALE
  TEXT
  BINARY
  NUMERIC
  WORDCLOUD
  SORT
  SHORT_ANSWER
  PRIORITIZATION
  FLASHCARD
  SLIDE
}

input CreateChoiceContentInput {
  questionnaireId: UUID!
  body: String!
  options: [String!]!
  correctOptionIndexes: [Int!]
  multiple: Boolean
  duration: Int
  weight: Int
  abstentionsAllowed: Boolean
}

input UpdateChoiceContentInput {
  id: UUID!
  body: String!
  options: [String!]!
  correctOptionIndexes: [Int!]
  multiple: Boolean
  duration: Int
  weight: Int
  abstentionsAllowed: Boolean
}

input CreateFlashcardContentInput {
  questionnaireId: UUID!
  body: String!
  answer: String!
}

input UpdateFlashcardContentInput {
  id: UUID!
  body: String!
  answer: String!
}

input CreateSlideContentInput {
  questionnaireId: UUID!
  body: String!
}

input UpdateSlideContentInput {
  id: UUID!
  body: String!
}

input UpdateWordcloudContentInput {
  id: UUID!
  body: String!
  duration: Int
  abstentionsAllowed: Boolean
  maxAnswers: Int!
}

input CreateWordcloudContentInput {
  questionnaireId: UUID!
  body: String!
  duration: Int
  abstentionsAllowed: Boolean
  maxAnswers: Int!
}
