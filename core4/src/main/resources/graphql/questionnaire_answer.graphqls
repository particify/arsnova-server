extend type Query {
  questionnaireAnswerByRoundId(roundId: UUID!): Answer
  questionnaireContentAnswerResultsByQuestionnaireId(
    questionnaireId: UUID!
  ): [ContentAnswerResult!]
  questionnaireAnswerResultsByQuestionnaireId(
    questionnaireId: UUID!
  ): QuestionnaireAnswerResult
  questionnaireTextAnswersByRoundId(roundId: UUID!): [Answer!]
}

extend type Mutation {
  createQuestionnaireChoiceAnswer(input: CreateChoiceAnswerInput!): Answer
  createQuestionnaireNumericAnswer(input: CreateNumericAnswerInput!): Answer
  createQuestionnairePrioritizationAnswer(
    input: CreatePrioritizationAnswerInput!
  ): Answer
  createQuestionnaireScaleAnswer(input: CreateScaleAnswerInput!): Answer
  createQuestionnaireShortAnswerAnswer(
    input: CreateShortAnswerAnswerInput!
  ): Answer
  createQuestionnaireSortAnswer(input: CreateSortAnswerInput!): Answer
  createQuestionnaireTextAnswer(input: CreateTextAnswerInput!): Answer
  createQuestionnaireWordcloudAnswer(input: CreateWordcloudAnswerInput!): Answer
  createQuestionnaireAbstention(roundId: UUID!): Answer
  deleteQuestionnaireAnswersByContentId(contentId: UUID!): Boolean
  toggleQuestionnaireTextAnswerHidden(answerId: UUID!, hidden: Boolean!): Answer
}

extend type Subscription {
  questionnaireTextAnswersUpdated(roundId: UUID!): [Answer!]
}

type Answer {
  id: ID!
  result: AnswerResultState!
  formatData: AnswerFormatData
  durationMs: Int
  hidden: Boolean!
  createdAt: DateTime
}

union AnswerFormatData =
  | ChoiceAnswerFormatData
  | NumericAnswerFormatData
  | PrioritizationAnswerFormatData
  | ScaleAnswerFormatData
  | ShortAnswerAnswerFormatData
  | SortAnswerFormatData
  | TextAnswerFormatData
  | WordcloudAnswerFormatData

type ChoiceAnswerFormatData {
  format: ContentType!
  selectedChoiceIndexes: [Int!]!
}

type NumericAnswerFormatData {
  format: ContentType!
  selectedNumber: Float!
}

type PrioritizationAnswerFormatData {
  format: ContentType!
  assignedPoints: [Int!]!
}

type WordcloudAnswerFormatData {
  format: ContentType!
  words: [String!]!
}

type ScaleAnswerFormatData {
  format: ContentType!
  rating: Int!
}

type ShortAnswerAnswerFormatData {
  format: ContentType!
  body: String!
}

type SortAnswerFormatData {
  format: ContentType!
  selectedChoiceIndexes: [Int!]!
}

type TextAnswerFormatData {
  format: ContentType!
  body: String!
}

type ContentAnswerResult {
  contentId: UUID!
  result: AnswerResultState!
  durationMs: Int
}

type QuestionnaireAnswerResult {
  questionnaireId: UUID!
  correctAnswerCount: Int
  scorableContentCount: Int
  achievedScore: Int
  maxScore: Int
}

enum AnswerResultState {
  UNANSWERED
  ABSTAINED
  NEUTRAL
  CORRECT
  WRONG
}

input CreateChoiceAnswerInput {
  roundId: UUID!
  selectedChoiceIndexes: [Int!]!
}

input CreateNumericAnswerInput {
  roundId: UUID!
  selectedNumber: Float!
}

input CreatePrioritizationAnswerInput {
  roundId: UUID!
  assignedPoints: [Int!]!
}

input CreateScaleAnswerInput {
  roundId: UUID!
  rating: Int!
}

input CreateShortAnswerAnswerInput {
  roundId: UUID!
  body: String!
}

input CreateSortAnswerInput {
  roundId: UUID!
  selectedChoiceIndexes: [Int!]!
}

input CreateTextAnswerInput {
  roundId: UUID!
  body: String!
}

input CreateWordcloudAnswerInput {
  roundId: UUID!
  words: [String!]!
}
