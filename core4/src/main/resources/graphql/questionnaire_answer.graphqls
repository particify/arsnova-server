extend type Query {
  questionnaireAnswerByRoundId(roundId: UUID!): Answer
  questionnaireContentAnswerResultsByQuestionnaireId(
    questionnaireId: UUID!
  ): [ContentAnswerResult!]
  questionnaireAnswerResultsByQuestionnaireId(
    questionnaireId: UUID!
  ): QuestionnaireAnswerResult
  questionnaireTextAnswersByRoundId(roundId: UUID!): [Answer!]
}

extend type Mutation {
  createQuestionnaireChoiceAnswer(input: CreateChoiceAnswerInput!): Answer
  createQuestionnaireTextAnswer(input: CreateTextAnswerInput!): Answer
  createQuestionnaireWordcloudAnswer(input: CreateWordcloudAnswerInput!): Answer
  createQuestionnaireAbstention(roundId: UUID!): Answer
  deleteQuestionnaireAnswersByContentId(contentId: UUID!): Boolean
  toggleQuestionnaireTextAnswerHidden(answerId: UUID!, hidden: Boolean!): Answer
}

extend type Subscription {
  questionnaireTextAnswersUpdated(roundId: UUID!): [Answer!]
}

type Answer {
  id: ID!
  result: AnswerResultState!
  formatData: AnswerFormatData
  durationMs: Int
  hidden: Boolean!
  createdAt: DateTime
}

union AnswerFormatData =
  | ChoiceAnswerFormatData
  | TextAnswerFormatData
  | WordcloudAnswerFormatData

type ChoiceAnswerFormatData {
  format: ContentType!
  selectedChoiceIndexes: [Int!]!
}

type WordcloudAnswerFormatData {
  format: ContentType!
  words: [String!]!
}

type TextAnswerFormatData {
  format: ContentType!
  body: String!
}

type ContentAnswerResult {
  contentId: UUID!
  result: AnswerResultState!
  durationMs: Int
}

type QuestionnaireAnswerResult {
  questionnaireId: UUID!
  correctAnswerCount: Int
  scorableContentCount: Int
  achievedScore: Int
  maxScore: Int
}

enum AnswerResultState {
  UNANSWERED
  ABSTAINED
  NEUTRAL
  CORRECT
  WRONG
}

input CreateChoiceAnswerInput {
  roundId: UUID!
  selectedChoiceIndexes: [Int!]!
}

input CreateTextAnswerInput {
  roundId: UUID!
  body: String!
}

input CreateWordcloudAnswerInput {
  roundId: UUID!
  words: [String!]!
}
