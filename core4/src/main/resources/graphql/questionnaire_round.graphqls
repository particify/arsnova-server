extend type Query {
  questionnaireRoundsByContentId(contentId: UUID!): [Round!]
  questionnaireBinaryRoundStatsByRoundId(
    roundId: UUID!
  ): BinaryContentRoundStats
  questionnaireChoiceRoundStatsByRoundId(
    roundId: UUID!
  ): ChoiceContentRoundStats
  questionnaireNumericRoundStatsByRoundId(
    roundId: UUID!
  ): NumericContentRoundStats
  questionnairePrioritizationRoundStatsByRoundId(
    roundId: UUID!
  ): PrioritizationContentRoundStats
  questionnaireScaleRoundStatsByRoundId(roundId: UUID!): ScaleContentRoundStats
  questionnaireShortAnswerRoundStatsByRoundId(
    roundId: UUID!
  ): ShortAnswerContentRoundStats
  questionnaireSortRoundStatsByRoundId(roundId: UUID!): SortContentRoundStats
  questionnaireWordcloudRoundStatsByRoundId(
    roundId: UUID!
  ): WordcloudContentRoundStats
}

extend type Mutation {
  startQuestionnaireContentRound(contentId: UUID!): Round!
}

extend type Subscription {
  questionnaireBinaryRoundStatsUpdated(roundId: UUID!): BinaryContentRoundStats
  questionnaireChoiceRoundStatsUpdated(roundId: UUID!): ChoiceContentRoundStats
  questionnaireNumericRoundStatsUpdated(
    roundId: UUID!
  ): NumericContentRoundStats
  questionnairePrioritizationRoundStatsUpdated(
    roundId: UUID!
  ): PrioritizationContentRoundStats
  questionnaireScaleRoundStatsUpdated(roundId: UUID!): ScaleContentRoundStats
  questionnaireShortAnswerRoundStatsUpdated(
    roundId: UUID!
  ): ShortAnswerContentRoundStats
  questionnaireSortRoundStatsUpdated(roundId: UUID!): SortContentRoundStats
  questionnaireWordcloudRoundStatsUpdated(
    roundId: UUID!
  ): WordcloudContentRoundStats
}

type Round {
  id: ID!
  contentId: ID
  roundNo: Int!
  closed: Boolean!
  started: Boolean!
  answeringEndTime: DateTime
  answerable: Boolean!
}

type BinaryContentRoundStats {
  selectionCounts: [Int!]
}

type ChoiceContentRoundStats {
  selectionCounts: [Int!]
}

type NumericContentRoundStats {
  selectedNumbers: [Float!]
  counts: [Int!]
  mean: Float!
  median: Float!
  standardDeviation: Float!
  variance: Float!
  minimum: Float!
  maximum: Float!
  correctAnswerFraction: Float
}

type PrioritizationContentRoundStats {
  assignedPoints: [Int!]
}

type ScaleContentRoundStats {
  counts: [Int!]
}

type ShortAnswerContentRoundStats {
  texts: [String!]
  counts: [Int!]
}

type SortContentRoundStats {
  combinations: [SortCombination!]
}

type SortCombination {
  selectedChoiceIndexes: [Int!]!
  count: Int!
}

type WordcloudContentRoundStats {
  words: [String!]
  counts: [Int!]
}
