#!/bin/bash
COMMAND=$1

if ! command -v git &> /dev/null; then
  echo ERROR: Git is not installed.
  exit 1
fi

if ! command -v docker &> /dev/null; then
  echo ERROR: Docker Engine is not installed.
  echo
  echo https://docs.docker.com/engine/install/
  exit 1
fi

if ! docker compose &> /dev/null; then
  echo ERROR: Docker Compose v2 is not installed.
  echo
  echo https://docs.docker.com/compose/install/compose-plugin/
  echo
  echo On Debian-based systems:
  echo apt install docker-compose-plugin
  exit 1
fi

if [ ! -f .version ] || ! read CONFIG_VERSION <.version; then
  CONFIG_VERSION=1
fi
if [ "$CONFIG_VERSION" -gt 2 ]; then
  echo ERROR: Configuration was created by a newer version.
  exit 1
fi

# Everything the release ships and an operator is not meant to edit. Kept out of the deployment
# root so that what is left there is the handful of files which are meant to be edited.
PROVIDED_DIR=provided
TLS_CERT_DIR=${TLS_CERT_DIR:-./tls}
APISIX_TEMPLATE="`dirname $0`/$PROVIDED_DIR/apisix-routes.yaml"
CORE_CONFIG_DIR=${CORE_CONFIG_DIR:-./core-config}
CORE4_CONFIG_DIR=${CORE4_CONFIG_DIR:-./core4-config}

ENV_FILES=""
COMPOSE_FILE_ARGS=""
while read config_name; do
  if [ -f "$PROVIDED_DIR/$config_name.env" ]; then
    ENV_FILES="$ENV_FILES $PROVIDED_DIR/$config_name.env"
  fi
  COMPOSE_FILE_ARGS="$COMPOSE_FILE_ARGS -f $PROVIDED_DIR/$config_name.compose.yaml"
done <"$PROVIDED_DIR/config-list"
while read config_name; do
  COMPOSE_FILE_ARGS="$COMPOSE_FILE_ARGS -f $PROVIDED_DIR/production.$config_name.compose.yaml"
done <"$PROVIDED_DIR/config-list"

# particifyctl never sources .env, so a setting the gateway configuration needs is read from the
# same merged view of the env files that update-config writes, where the last definition wins.
read_env() {
  cat $ENV_FILES "$PROVIDED_DIR/production.env" local.env 2> /dev/null \
    | grep "^$1=" | tail -n 1 | cut -d = -f 2-
}

case $COMMAND in
  update|u)
    echo Updating Git repository...
    git pull
    $0 update-config || exit $?
    echo Updating Docker images...
    docker compose --project-directory `dirname $0` \
      $COMPOSE_FILE_ARGS \
      -f local.compose.yaml \
      pull
    ;;
  update-config)
    echo Updating configuration for Docker Compose...
    if [ ! -f local.env ]; then
      echo "# Custom environment configuration overrides" > local.env
      if [ -L .env ]; then
        cat .env >> local.env
        rm .env
      fi
    fi
    if [ ! -f local.compose.yaml ]; then
      echo -e "# Custom Docker Compose configuration overrides\nservices: {}" > local.compose.yaml
    fi
    echo "# GENERATED - DO NOT EDIT - RUN $0 $1 TO UPDATE" > .env
    cat $ENV_FILES "$PROVIDED_DIR/production.env" local.env \
      | grep -v ^# | tac | awk -F "=" '!a[$1]++' | tac >> .env
    # Create the bind sources as the invoking user; the engine would create them root-owned.
    mkdir -p "$CORE_CONFIG_DIR" "$CORE4_CONFIG_DIR"
    if grep -qx v4 "$PROVIDED_DIR/config-list" && [ ! -f "$CORE4_CONFIG_DIR/application.yaml" ]; then
      echo "WARNING: $CORE4_CONFIG_DIR/application.yaml does not exist."
      echo "         core4 requires mail.sender-address, mail.sender-name, service.root-url and"
      echo "         security.challenge.secret, none of which an environment variable provides."
      echo "         See docs/admin/upgrading-to-v4.adoc."
    fi
    # LEGACY_POSTGRESQL_TAG is the only variable an image reference needs which no shipped env file
    # defines. Unset, it renders the legacy databases as the bare name postgres:, which Docker
    # Compose interpolates without complaint and only rejects when the image is pulled. They are
    # the only images it governs and the v3-migration profile is the only thing which starts them,
    # so an installation which never held version 3 data never needs it.
    case ",`read_env COMPOSE_PROFILES`," in
      *,v3-migration,*)
        if [ -z "`read_env LEGACY_POSTGRESQL_TAG`" ]; then
          echo "ERROR: COMPOSE_PROFILES names v3-migration but LEGACY_POSTGRESQL_TAG is not set." >&2
          echo "       It pins the PostgreSQL version of the legacy databases' data directory," >&2
          echo "       and the wrong one makes PostgreSQL create an empty cluster beside your" >&2
          echo "       data and report itself healthy. Read the version off the volume as" >&2
          echo "       docs/admin/installation.adoc describes, and set it in local.env." >&2
          exit 1
        fi
        ;;
    esac
    # apisix.yaml is generated as well, and the gateway mounts it as a file: with no file there the
    # container engine creates a directory at that path instead, and APISIX exits unable to read its
    # own routes. Generated only when absent -- regenerating it belongs to update-gateway, which
    # would otherwise pick up certificate changes an operator has not finished making.
    if [ -d apisix.yaml ]; then
      echo "ERROR: apisix.yaml is a directory." >&2
      echo "       A container engine creates one when a bind mount's source does not exist." >&2
      echo "       Remove it and run this again." >&2
      exit 1
    fi
    if [ ! -f apisix.yaml ]; then
      $0 update-gateway
    fi
    echo "# GENERATED - DO NOT EDIT - RUN $0 $1 TO UPDATE" > .compose.yaml
    docker compose --project-directory . \
      $COMPOSE_FILE_ARGS \
      -f local.compose.yaml \
      config >> .compose.yaml
    if [ ! -f .version ]; then
      echo "$CONFIG_VERSION" > .version
    fi
    # .env carries JWT_SECRET, so it must not be left at the ambient umask.
    chmod 600 .env local.env
    ;;
  update-gateway)
    # Everything the gateway needs beyond its shipped routes is generated into apisix.yaml:
    # the TLS certificates, the redirect from a hostname alias to the canonical host, and the
    # content security policy. APISIX reads a static file, so none of it can be resolved from the
    # environment at startup.
    #
    # APISIX validates ssls.cert against a minimum length and then parses it as PEM, so a file
    # path is rejected - silently, leaving the gateway on plaintext. The certificates therefore
    # have to be inlined, which means apisix.yaml has to be generated rather than mounted.
    #
    # Certificates are read as <hostname>_key.pem and <hostname>_cer.pem, plus an optional
    # <hostname>_ca.pem chain, which is concatenated into the certificate because APISIX has no
    # separate setting for it. Re-run this after renewing; APISIX picks the change up without a
    # restart.
    if [ ! -f "$APISIX_TEMPLATE" ]; then
      echo "ERROR: $APISIX_TEMPLATE not found."
      exit 1
    fi
    mkdir -p "$TLS_CERT_DIR"
    keys=`ls "$TLS_CERT_DIR"/*_key.pem 2> /dev/null`
    # Checked up front, so a missing certificate cannot leave a half-written file behind.
    for key in $keys; do
      hostname=`basename "$key" _key.pem`
      if [ ! -f "$TLS_CERT_DIR/${hostname}_cer.pem" ]; then
        echo "ERROR: $key has no matching ${hostname}_cer.pem."
        exit 1
      fi
    done

    canonical_hostname=`read_env ARSNOVA_HOSTNAME`
    hostname_aliases=`read_env ARSNOVA_HOSTNAME_ALIASES`
    csp_frame_ancestors=`read_env CSP_FRAME_ANCESTORS`
    if [ -n "$hostname_aliases" ] && [ -z "$canonical_hostname" ]; then
      echo "ERROR: ARSNOVA_HOSTNAME_ALIASES is set but ARSNOVA_HOSTNAME is not."
      exit 1
    fi
    # The redirect follows the gateway's own scheme: targeting https unconditionally would strand
    # a plaintext installation on a scheme it does not serve.
    if [ -n "$keys" ]; then
      alias_scheme=https
    else
      alias_scheme=http
    fi

    # An alias would otherwise just serve the application: no route in the template matches on
    # Host, so the gateway answers on every name it is reachable by. The priority is what makes
    # this route win for these names -- every route in the template leaves it at the default of 0,
    # including the /api/* ones, which have to be redirected as well. The uri form interpolates
    # $request_uri, which carries the query string; regex_uri matches the path alone and would
    # drop it.
    alias_route=""
    if [ -n "$hostname_aliases" ]; then
      alias_hosts=""
      for alias in $hostname_aliases; do
        alias_hosts="$alias_hosts      - $alias
"
      done
      alias_route="  - id: hostname-aliases
    uris:
      - /*
    hosts:
${alias_hosts}    priority: 100
    plugins:
      redirect:
        uri: \"$alias_scheme://$canonical_hostname\$request_uri\"
        ret_code: 301"
    fi

    # A global rule applies to every route without being repeated on each one. It runs before the
    # matched route's own plugins, so a plaintext request to an alias is redirected to HTTPS first
    # and reaches the alias route on its second hop.
    global_plugins=""
    if [ -n "$keys" ]; then
      # The plugin answers 301 to GET and HEAD and 308 otherwise, so a request keeps its method
      # and body.
      global_plugins="$global_plugins      redirect:
        http_to_https: true
"
    fi
    if [ -n "$csp_frame_ancestors" ]; then
      # The header goes on every response rather than only on the documents which can be framed.
      # An installation embedding the application in an LMS has to list the LMS origins here, or
      # the launch is blocked.
      global_plugins="$global_plugins      response-rewrite:
        headers:
          set:
            Content-Security-Policy: \"frame-ancestors $csp_frame_ancestors\"
"
    fi

    # A truncated file takes down all routing rather than just TLS, so build it aside first.
    {
      # The gateway reads this file directly, so it is easy to mistake for something to edit. The
      # timestamp is what tells an operator whether it predates a certificate or a hostname change
      # they have since made, which is the case this command exists for.
      echo "# GENERATED - DO NOT EDIT - RUN $0 update-gateway TO UPDATE"
      echo "# Generated `date -u +%Y-%m-%dT%H:%M:%SZ` from the shipped routes, ./tls and the environment."
      awk -v route="$alias_route" \
        '/^routes:[[:space:]]*$/ { print; if (route != "") print route; next } 1' \
        "$APISIX_TEMPLATE" | sed '/^#END[[:space:]]*$/d'
      if [ -n "$global_plugins" ]; then
        echo 'global_rules:'
        echo '  - id: gateway'
        echo '    plugins:'
        printf '%s' "$global_plugins"
      fi
      if [ -n "$keys" ]; then
        echo 'ssls:'
        for key in $keys; do
          hostname=`basename "$key" _key.pem`
          cert="$TLS_CERT_DIR/${hostname}_cer.pem"
          echo "  - id: $hostname"
          echo '    snis:'
          echo "      - $hostname"
          # An alias only reaches its redirect if the handshake completes, and APISIX aborts that
          # when the SNI matches no entry at all. The aliases get no entry of their own, so a
          # certificate which does not cover them warns in the browser first.
          if [ "$hostname" = "$canonical_hostname" ]; then
            for alias in $hostname_aliases; do
              echo "      - $alias"
            done
          fi
          echo '    cert: |'
          cat "$cert" "$TLS_CERT_DIR/${hostname}_ca.pem" 2> /dev/null | sed 's/^/      /'
          echo '    key: |'
          sed 's/^/      /' "$key"
        done
      fi
      # Required as the last line, or APISIX ignores the whole file.
      echo '#END'
    } > apisix.yaml.new
    if [ "`tail -n 1 apisix.yaml.new`" != '#END' ]; then
      echo "ERROR: the generated configuration is incomplete; apisix.yaml was left unchanged."
      rm -f apisix.yaml.new
      exit 1
    fi
    # Written in place rather than moved over: a single-file bind mount pins the inode, so
    # replacing the file would leave APISIX reading the old one and never reloading.
    cat apisix.yaml.new > apisix.yaml
    rm -f apisix.yaml.new
    if [ -z "$keys" ]; then
      echo "No certificates in $TLS_CERT_DIR, so the gateway will serve plain HTTP only."
      echo "Add <hostname>_key.pem and <hostname>_cer.pem there and run this again."
    fi
    for key in $keys; do
      echo "Configured TLS for `basename \"$key\" _key.pem`."
    done
    if [ -n "$hostname_aliases" ]; then
      echo "Redirecting $hostname_aliases to $alias_scheme://$canonical_hostname."
    fi
    if [ -n "$csp_frame_ancestors" ]; then
      echo "Restricting frame ancestors to $csp_frame_ancestors."
    fi
    echo Wrote apisix.yaml. Run \"$0 update-config\" to apply it.
    ;;
  run|r)
    # Without this the containers come up on whatever configuration was generated last, which is
    # the one update-config just refused to replace.
    $0 update-config || exit $?
    echo Starting Containers...
    shift 1
    docker compose -f .compose.yaml up $@
    ;;
  logs|l)
    if [ ! -f .compose.yaml ]; then
      $0 update-config || exit $?
    fi
    shift 1
    docker compose -f .compose.yaml logs $@
    ;;
  compose|c)
    if [ ! -f .compose.yaml ]; then
      $0 update-config || exit $?
    fi
    shift 1
    docker compose -f .compose.yaml $@
    ;;
  *)
    echo Usage:
    echo "    $0 update           Update Git repositories, Docker Compose configuration and Docker images"
    echo "    $0 update-config    Update the configuration for Docker Compose"
    echo "    $0 update-gateway   Generate the gateway configuration from ./tls and the environment"
    echo "    $0 run              Start Containers for all services"
    echo "    $0 logs             Show logs or the log for a specific service"
    echo "    $0 compose          Execute a Docker Compose command"
    ;;
esac
